# Database
# Local dev defaults to SQLite (no setup needed). For production use Neon Postgres:
# DATABASE_URL=postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./testpilot.db

# JWT
SECRET_KEY=change-me-to-a-long-random-256-bit-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider — "ollama" for local dev, "groq" for production
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
